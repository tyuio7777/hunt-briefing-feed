{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyuio7777/hunt-briefing-feed/schema/briefing-v1.schema.json",
  "title": "Hunt Briefing Feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "language",
    "title",
    "published_at",
    "updated_at",
    "hero",
    "summary",
    "sections",
    "html_url"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "language": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_url",
        "alt",
        "source_url"
      ],
      "properties": {
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "alt": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "title",
          "description",
          "display_type",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_type": {
            "enum": [
              "cards",
              "ranking",
              "story",
              "regions",
              "videos",
              "muted"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "title",
                "summary",
                "body",
                "image_url",
                "badges",
                "confidence",
                "region",
                "published_at",
                "sources"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "article",
                    "rumor",
                    "signal",
                    "story",
                    "region",
                    "video",
                    "reference"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "body": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "badges": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "confirmed",
                    "high",
                    "medium",
                    "low",
                    null
                  ]
                },
                "region": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "url"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "html_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
