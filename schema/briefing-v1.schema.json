{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tyuio7777/hunt-briefing-feed/schema/briefing-v1.schema.json",
  "title": "Hunt Briefing Feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "language",
    "title",
    "published_at",
    "updated_at",
    "hero",
    "summary",
    "sections",
    "html_url"
  ],
  "properties": {
    "calendar_events": {
      "type": "array",
      "description": "브리핑 본문에서 확인한 주요 일정. 누락된 과거 파일은 앱에서 빈 배열로 처리합니다. 날짜는 한국시간 기준이며 날짜만 공개된 일정은 임의의 시간을 부여하지 않습니다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "title",
          "summary",
          "start_date",
          "end_date",
          "source_url",
          "status"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "description": "동일 일정은 브리핑 간 같은 ID를 유지합니다. 일정 변경·취소 시에도 유지합니다."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "description": "포함되는 시작 날짜. 출시·해금·점검 시작 같은 시점 표식은 end_date와 같습니다."
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "description": "포함되는 마지막 날짜. start_date 이상이어야 합니다. 전체 기간이 불명확하면 알려진 시작/종료 시점만 제목에 명시해 하루 표식으로 기록합니다."
          },
          "source_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "tentative",
              "cancelled"
            ]
          },
          "start_at": {
            "type": "string",
            "format": "date-time",
            "description": "시간과 시간대가 명확한 경우에만 기록. 임의의 자정이나 예상 종료 시각을 확정 시각으로 넣지 않습니다."
          },
          "end_at": {
            "type": "string",
            "format": "date-time",
            "description": "확인된 종료 시각. 날짜와 시간대 변환 후 일치해야 하며 start_at 이후 또는 같은 시각이어야 합니다."
          }
        }
      }
    },
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "language": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": [
        "string",
        "null"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image_url",
        "alt",
        "source_url"
      ],
      "properties": {
        "image_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "alt": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "title",
          "description",
          "display_type",
          "items"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_type": {
            "enum": [
              "cards",
              "ranking",
              "story",
              "regions",
              "videos",
              "muted"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "title",
                "summary",
                "body",
                "image_url",
                "badges",
                "confidence",
                "region",
                "published_at",
                "sources"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "article",
                    "rumor",
                    "signal",
                    "story",
                    "region",
                    "video",
                    "reference"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "body": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "image_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri"
                },
                "badges": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "confirmed",
                    "high",
                    "medium",
                    "low",
                    null
                  ]
                },
                "region": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "url"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "html_url": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
